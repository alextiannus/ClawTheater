# Claw Theater — Production Environment Variables Reference
# Copy this to .env.local on your production server or fill in Render Dashboard

# Core Configuration
NODE_ENV=production
DATABASE_URL="postgresql://admin:YOUR_PASSWORD@YOUR_DB_HOST:5432/clawtheater?schema=public&pgbouncer=true"

# Privy (Auth)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Stripe (Payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 (Storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Solana
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=
